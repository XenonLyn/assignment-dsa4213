# data (downloaded automatically, see README) and public embeddings
data/
# model checkpoints / embedding tables: large, regenerated by the run scripts
*.pt
*.pkl
# vocabulary copies (rebuilt deterministically from the training split)
runs/**/vocab.json
emb/*.vocab.json
# raw stdout of the run scripts (per-model logs are in runs/logs/)
runs_*.out

.venv/
__pycache__/
.DS_Store
